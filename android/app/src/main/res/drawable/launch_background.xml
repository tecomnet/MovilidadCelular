<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash en Android 11 y anteriores. A partir de Android 12 el sistema dibuja
    el arranque él mismo e ignora este archivo: ese caso está en
    values-v31/styles.xml. Los dos pintan lo mismo, el globo sobre el fondo de
    marca, para que se vea igual en cualquier versión.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fondo" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_globo" />
    </item>
</layer-list>
